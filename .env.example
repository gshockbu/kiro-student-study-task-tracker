# PostgreSQL connection settings for the Study Task Tracker
# Copy this file to .env and fill in your local values.
# NEVER commit .env to version control.

TRACKER_DB_HOST=localhost
TRACKER_DB_PORT=5432
TRACKER_DB_NAME=tracker
TRACKER_DB_USER=
TRACKER_DB_PASSWORD=

# For running tests, point at the test database:
# TRACKER_DB_NAME=tracker_test
